<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ============================================================
    # SECURITY: Force HTTPS (skip on localhost for dev)
    # ============================================================
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # ============================================================
    # SECURITY: Block access to hidden files (.env, .git, .htaccess, etc.)
    # Exception: .well-known/ for SSL cert validation and security.txt
    # ============================================================
    RewriteCond %{REQUEST_URI} (^|/)\.(?!well-known/) [NC]
    RewriteRule ^ - [F,L]

    # ============================================================
    # SECURITY: Block PHP execution in asset directories
    # This is the #1 defense against uploaded/injected PHP shells
    # ============================================================
    RewriteCond %{REQUEST_URI} ^/(css|js|images|build|storage|fonts|uploads|assets|media|vendor)/.*\.php$ [NC]
    RewriteRule ^ - [F,L]

    # ============================================================
    # SECURITY: Block dangerous file extensions in asset dirs
    # ============================================================
    RewriteCond %{REQUEST_URI} ^/(css|js|images|build|storage|fonts|uploads|assets|media|vendor)/.*\.(phtml|php3|php4|php5|php7|phps|cgi|pl|py|sh|bash|asp|aspx|jsp|exe|dll|com|bat|cmd)$ [NC]
    RewriteRule ^ - [F,L]

    # ============================================================
    # SECURITY: Block access to sensitive file types
    # ============================================================
    <FilesMatch "\.(sql|sqlite|sqlite3|bak|log|ini|conf|yml|yaml|xml|json|lock|env|htpasswd)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    # Allow specific JSON/XML files that need to be public
    <FilesMatch "(manifest\.json|site\.webmanifest|sitemap\.xml|robots\.txt)$">
        <IfModule mod_authz_core.c>
            Require all granted
        </IfModule>
    </FilesMatch>

    # ============================================================
    # SECURITY: Block common exploit patterns in URL/query string
    # ============================================================
    RewriteCond %{REQUEST_URI} (eval\(|base64_decode|gzinflate|str_rot13|system\(|exec\(|passthru\(|shell_exec\() [NC,OR]
    RewriteCond %{QUERY_STRING} (eval\(|base64_decode|gzinflate|str_rot13|system\(|exec\(|passthru\(|shell_exec\() [NC]
    RewriteRule ^ - [F,L]

    # ============================================================
    # SECURITY: Block WordPress/CMS vulnerability scanners
    # ============================================================
    RewriteCond %{REQUEST_URI} (wp-admin|wp-login|wp-content|wp-includes|xmlrpc\.php|wlwmanifest\.xml) [NC,OR]
    RewriteCond %{REQUEST_URI} (phpmyadmin|pma|adminer|myadmin|phpinfo) [NC,OR]
    RewriteCond %{REQUEST_URI} \.(?:git|svn|hg|bzr)/ [NC]
    RewriteRule ^ - [F,L]

    # ============================================================
    # STANDARD LARAVEL RULES (do not modify)
    # ============================================================

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Disable directory browsing
Options -Indexes

# Hide server software version
ServerSignature Off

# Prevent MIME sniffing at Apache level
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
