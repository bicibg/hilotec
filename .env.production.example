# =============================================================================
# Production Environment Variables - Security Settings
#
# Copy the relevant lines to your production .env file.
# These are the MINIMUM security-related settings you need.
# =============================================================================

# --- Application ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# --- Session Security ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# --- Logging (don't expose debug info) ---
LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Admin Access (comma-separated email addresses) ---
ADMIN_EMAILS=admin@yourdomain.com

# --- reCAPTCHA v3 (get keys from https://www.google.com/recaptcha/admin/create) ---
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Mail (for security alerts) ---
MAIL_TO=admin@yourdomain.com
